{
  "name": "mind-the-deer",
  "version": "0.1.0",
  "private": true,
  "description": "鹿のフンを避けて参道を歩く、16bit風の縦スクロール避けゲー",
  "scripts": {
    "start": "expo start --dev-client",
    "start:go": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.web.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.web.json && tsc --noEmit",
    "verify": "npm run build && node test/verify.mjs",
    "icons": "node tools/make-icons.mjs",
    "bundle": "node tools/bundle-game.mjs",
    "native:sync": "npm run build && npm run bundle"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@types/react": "~19.1.0",
    "babel-preset-expo": "~54.0.10",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "~2.1.0",
    "expo": "~54.0.0",
    "expo-splash-screen": "~31.0.0",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-google-mobile-ads": "^16.4.0",
    "react-native-webview": "^13.15.0"
  },
  "main": "index.ts"
}
